From a82270fc976a9cce70a9f496cd40e4f96f5a3165 Mon Sep 17 00:00:00 2001
From: njq8 <318205820+njq8x@users.noreply.github.com>
Date: Mon, 26 Oct 2026 22:55:40 +0500
Subject: [PATCH] Update the Maven build plugins

- maven-jar-plugin 2.1 -> 3.5.0 (2.1 predates Maven 3 and is no longer
  supported; manifest sections still work)
- maven-shade-plugin 3.2.1 -> 3.6.2
- maven-compiler-plugin 3.8.1 -> 3.15.0

The shaded manifest still carries Implementation-Version and the sealed
package sections, and both smoke test modes pass.

diff --git a/pom.xml b/pom.xml
index dea374eb1..1ef78125b 100644
--- a/pom.xml
+++ b/pom.xml
@@ -161,7 +161,7 @@
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-jar-plugin</artifactId>
-        <version>2.1</version>
+        <version>3.5.0</version>
         <configuration>
           <archive>
             <manifestEntries>
@@ -200,7 +200,7 @@
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-shade-plugin</artifactId>
-        <version>3.2.1</version>
+        <version>3.6.2</version>
         <executions>
           <execution>
             <phase>package</phase>
@@ -213,7 +213,7 @@
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-compiler-plugin</artifactId>
-        <version>3.8.1</version>
+        <version>3.15.0</version>
         <configuration>
           <source>1.8</source>
           <target>1.8</target>
-- 
2.47.3

